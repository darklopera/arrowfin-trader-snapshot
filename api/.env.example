# --- copy to .env (never commit it) -------------------------------------------
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000

# Runtime connection: read-only role, subject to Row Level Security.
DATABASE_URL=postgresql://arrowfin_app:app_dev_password@localhost:54329/arrowfin
# Privileged connection: migrations, seed and the DEV fill simulator ONLY.
ADMIN_DATABASE_URL=postgresql://arrowfin_owner:owner_dev_password@localhost:54329/arrowfin

# >= 32 chars. Production: from a secret manager, rotated.
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_ISSUER=arrowfin-auth
JWT_AUDIENCE=arrowfin-snapshot-api
JWT_TTL_SECONDS=900

# Dev-only surface (POST /dev/fills, /dev/auth/*). The API refuses to boot with
# this on when NODE_ENV=production.
ENABLE_DEV_ENDPOINTS=true
DEV_API_KEY=change-me-dev-key
# Pin "now" to the dataset cut so the demo matches the assessment data.
SNAPSHOT_AS_OF=2026-08-25T14:30:00Z
